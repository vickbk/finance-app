# ==============================================================================
# Application Environment & Server Settings
# ==============================================================================
# Options: development, staging, production
APP_ENV=development
APP_PORT=8080

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# Database Host (e.g. ep-example-123456.us-east-1.aws.neon.tech or localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Set to "require" or "verify-full" for Neon cloud connections, or "disable" for local dev
DB_SSLMODE=disable

# Maximum open and idle connections in pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Secret key used for signing JWT tokens (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRATION_HOURS=24
